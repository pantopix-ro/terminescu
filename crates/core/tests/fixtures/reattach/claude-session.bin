8;2;215;119;87m▘▘   ▝▝[12G[38;2;153;153;153m~/src/acme-api[1C[1B[39m[K[2B[48;2;55;55;55m[38;2;153;153;153m❯ [38;2;255;255;255mWrite a numbered list of 30 short, practical tips for writing shell scripts. One line each.[39m       [1B[49m[K[1B[38;2;255;255;255m⏺[3G[39m1.[6GStart[12Gevery[18Gscript[25Gwith[30G[38;2;177;185;249m#!/usr/bin/env bash[50G[39mso[53Git[56Gruns[61Gunder[67Gthe[71Gshell[77Gyou[81Gexpect.[1B [3G2[6GAdd [38;2;177;185;249mset -euo pipefail[39m near the top to stop on erro[57Gs, unset variabl[74Gs,[77Gand[81Gpi[85G failures.[2C[1B3[6GQuote every variable exp[31Gnsion, as[41Gin[44G[38;2;177;185;249m"$file"[39m, to preve[62Gt word splitting and globb[89Gng.[K[2C[1B4[6GUse [38;2;177;185;249m"$@"[39m to[18Gp[20Gss arguments through, [43Got [38;2;177;185;249m$*[39m, which[56Gmerg[61Gs them into one string.[K[2C[1B5[10G[38;2;177;185;249m[[ ... ]][39m instead of [38;2;177;185;249m[ ... ][39m in[42GBash for safer string and[68Gpa[71Gter[75G tests.[K[2C[1B6[6GCh[9Gck that required commands exist with [38;2;177;185;249mcommand -v tool >/dev/null[39m before using[86Gthem.[2C[1B7[6GPut the core logic in functions, and call [49G[38;2;177;185;249mai[52G "$@"[39m at the bottom of the file.[K[2C[1B8[6GUse[10G[38;2;177;185;249mlocal[39m for variables ins[34Gde functions so they don'[61Gleak in[70G global scop[2C[1B9[6GWrite error messages to[30Gstderr[37Gwith [38;2;177;185;249mecho "error: ..." >&2[39m.[K[2C[1B10. Exit[12Gwith a non-z[25Gro sta[32Gus on failure, and document what[65Geach[70Gcode[75Gmeans.[3C[1B1[7GUse [38;2;177;185;249mtrap cleanup EXIT[39m [30Go rem[36Gve temporary files and restor[66G state on any exit.[3C[1B2[7GCr[10Gate temp files with [38;2;177;185;249mmktemp[39m ra[40Gher than[51Gx[53Gd[55Gnames in [38;2;177;185;249m/tmp[39m, which[76Gi[78Gvites collisions[95Gand[2C[1B   [7Gsymlink attacks.[K[2C[1B13.[7GValidate arguments[26Gearly[32Gand[36Gprint[42Ga[44Gshort[50Gusage[56Gmessage[64Gwhen[69Gthey[74Gare[78Gmissing.[3C[1B4[7GAdd a [38;2;177;185;249m-h[16G[39mo[18G [38;2;177;185;249m--help[26G[39mflag that[41Gs the usage t[55Gxt.[K[3C[1B5[7GUse[11G[38;2;177;185;249mgetopts[19G[39mfor simp[28Ge shor[36Goptions inste[50Gd of hand-parsing[68G[38;2;177;185;249m$1[39m.[3C[1B6[7GPrefer[14G[38;2;177;185;249m$(command)[25G[39mover[30Gbackticks,[41Gsince[47Git[50Gnests[56Gcleanly[64Gand[68Greads[74Gbetter.[2C[1B17.[30;1H[28;3H[?25h]0;◑ Shell scripting tips list[?25l[H [38;2;215;119;87m▘▘   ▝▝[39m [12G[38;2;153;153;153m~/src/acme-api[1C[1B[39m[K[1C[1B[K[1B[48;2;55;55;55m[38;2;153;153;153m❯ [38;2;255;255;255mWrite a numbered list of 30 short, practical tips for writing shell scripts. One line each.[39m       [2B[49m[38;2;255;255;255m⏺[39m 1. Start every script with [38;2;177;185;249m#!/usr/bin/env bash[39m so it runs under the shell you expect.[K[2C[1B2.[6GAdd[10G[38;2;177;185;249mset -euo pipefail[28G[39mnear[33Gthe[37Gtop[41Gto[44Gstop[49Gon[52Gerrors,[60Gunset[66Gvariables,[77Gand[81Gpipe[86Gfailures.[1B [3G3[6GQuote[18Gva[22Gable expansion, as in [38;2;177;185;249m"$file"[39m,[53Gto[56Gprevent word splitting and globbing.[2C[1B4[6GUse[10G[38;2;177;185;249m"$@"[39m to pass arguments[35Grough, not [38;2;177;185;249m$*[39m, which merges them into one[77Gstring.[K[2C[1B5[6GUse [38;2;177;185;249m[[ ... ]][39m instead of [38;2;177;185;249m[ ... ][39m in Bash for safer stri[62Gg[64Gand pattern tests.[83G[K[2C[1B6[6GCh[9Gck tha[16G required commands exist with[46G[38;2;177;185;249mcommand -v tool >/dev/null[73G[39mbefore using[86Gthem.[2C[1B7[6GPut[10Gthe core logic in[28Gfunctions,[39Ga[41Gd call [38;2;177;185;249mmain "$@"[39m at the bottom of th[78G file.[2C[1B8[6GUs[9G [38;2;177;185;249mlocal[39m for va[23Giables i[32Gsid[36G funct[43Gons so they don't leak into global scope.[K[2C[1B9[6GWrite [13Grr[17G messages to stderr with [38;2;177;185;249mecho "error: ..." >&2[39m.[65G[K[2C[1B10. Exit with a non-zero [29Gtatus on failure,[47Gand docume[58Gt what each code means.[K[2C[1B11. Use [38;2;177;185;249mtrap cleanup EXIT[39m to r[34Gmove [40Gemporary files and restore[67Gstate[73Gon[76Gany[80Gexit.[3C[1B2[7GCreate [15Gemp[19Gfiles with [38;2;177;185;249mmktemp[39m rather than fixed names in [38;2;177;185;249m/tmp[39m,[70Gwhich invites[84Gcollisions[95Gand[2C[1B   [7Gsymlink attacks.[K[3C[1B3[7GValidate arguments early and p[38Gint a[44Gs[46Gort usage mes[60Gage[64Gwhen they are m[80Gssing.[K[2C[1B14.[7GAdd a [38;2;177;185;249m-h[39m or [38;2;177;185;249m--help[26G[39mflag[31Gthat[36Gprints[43Gthe[47Gusage[53Gtext.[3C[1B5[7GUse [38;2;177;185;249mgetopts[39m for simple short[36Goptions[44Ginstead of hand-parsing [38;2;177;185;249m$1[39m.[K[3C[1B6[7GPrefer [38;2;177;185;249m$(command)[39m over back[35Gicks, [42Ginc[47Git n[52Gs[54Gs cleanly[64Gand[68Greads[74Gbetter.[3C[1B7[7GRead input line[23Gby line with[36G[38;2;177;185;249mwhile IFS= read -r line; do ...; done[39m,[75Gso[78Gspaces[85Gand[89Gbackslashes[2C[1B   [7Gsurvive.[K[3C[1B8[30;1H[28;3H[?25h[?25l[H[2G[K[2B[48;2;55;55;55m[38;2;153;153;153m❯ [38;2;255;255;255mWrite a numbered list of 30 short, practical tips for writing shell scripts. One line each.[39m       [1B[49m[K[1B[38;2;255;255;255m⏺[3G[39m1.[6GStart[12Gevery[18Gscript[25Gwith[30G[38;2;177;185;249m#!/usr/bin/env bash[50G[39mso[53Git[56Gruns[61Gunder[67Gthe[71Gshell[77Gyou[81Gexpect.[1B [3G2[6GAdd [38;2;177;185;249mset -euo pipefail[39m near the top to stop on erro[57Gs, unset variabl[74Gs,[77Gand[81Gpi[85G failures.[2C[1B3[6GQuote every variable exp[31Gnsion, as[4